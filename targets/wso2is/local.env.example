# Copy to local.env (gitignored). For a non-super tenant both URLs end in /t/<tenant>; the
# super tenant (no /t/...) is recommended: its request-signing key can be replaced with a
# CA-issued one (CONFIGURATION.md section 7).
#
# IS_PUBLIC_URL must be the URL IS advertises and that resolves to IS from the host AND from
# the docker containers (suite, Wallet2): a tunnel such as ngrok, or host.docker.internal.
IS_PUBLIC_URL=https://your-is.example.com/t/your-tenant
# Where vcit calls the admin APIs from the host (often https://localhost:9443/t/your-tenant).
IS_ADMIN_URL=https://localhost:9443/t/your-tenant
IS_ADMIN_USER=admin@your-tenant
IS_ADMIN_PASSWORD=admin
TEST_USER_PASSWORD=Vcit-Test-Pass-1
